{
  "buildCommand": "npm run install-all && cd dashboard && npm run build",
  "outputDirectory": "dashboard/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/raw/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{reports,datasets,documentation,experiments,figures,literature,results,code}/**"
    }
  }
}
